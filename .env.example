# Copy to .env and fill in. .env is git-ignored.

# OpenRouter key: turns on the Jev evidence engine and the agent.
OPENROUTER_API_KEY=

# Decision model used by the Jev evidence engine (OpenRouter System One API).
ELESSAR_DECISION_MODEL=jev-latest

# Inference model used by the agent (OpenRouter Anthropic Messages API).
ELESSAR_INFERENCE_MODEL=anthropic/claude-sonnet-5.5
